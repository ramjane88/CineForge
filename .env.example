# All keys can be pasted in the app's Keys tab instead, where they stay in the browser.
# Set this only if you want the shot writer to work without pasting a Groq key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: use Claude for the shot writer instead of Groq.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
